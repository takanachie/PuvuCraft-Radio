# Install as /etc/radio/radio.env with owner root:radio and mode 0640.
# This import path is an example; set it to the ASGI app exposed by the backend.
RADIO_ASGI_APP="backend.app.main:app"

# Generate a unique value with: openssl rand -hex 32
RADIO_SECRET_KEY="REPLACE_WITH_A_UNIQUE_RANDOM_SECRET"

PYTHONUNBUFFERED="1"
PYTHONDONTWRITEBYTECODE="1"
